/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://*.supabase.co https://*.supabase.in; object-src 'none'

# Private, per-user data is fetched at runtime; never let a shared cache keep the shell.
/index.html
  Cache-Control: no-store, private
/
  Cache-Control: no-store, private
/assets/*
  Cache-Control: public, max-age=31536000, immutable
